# =============================================================================
# MFS Gateway — environment configuration
# Copy this file to `.env` and fill values in:   cp .env.example .env
# `.env` is git-ignored (never commit real secrets).
# Real environment variables always override .env values.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
PORT=8000
# Flask session key + redirect/IPN signing key.
# Default: generated once and persisted to data/secret_key (chmod 600).
# GATEWAY_SECRET=

# ── Superadmin (SOURCE OF TRUTH — re-synced into the DB on every boot) ──────
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=change-me-to-a-long-random-string

# ── Database — PostgreSQL (the only production engine) ───────────────────────
# One single-line SQLAlchemy URL; the database name lives in the URL path.
#
#   local:    postgresql+psycopg://gateway:secret@localhost:5432/mfs_gateway
#   managed:  postgresql+psycopg://user:password@db.example.com:5432/mfs_gateway
#   plain postgresql:// / postgres:// URLs are auto-upgraded to psycopg 3.
#
DATABASE_URL=postgresql+psycopg://localhost:5432/mfs_gateway

# ── Dev helpers (never enable in production) ────────────────────────────────
# Show the configured admin/demo credentials on the login pages.
# GATEWAY_SHOW_LOGIN_HINTS=1
# Run the store against an in-memory SQLite database when no PostgreSQL server
# is reachable (restricted CI/sandboxes) — same SQLAlchemy code path, SQLite
# keeps its own transaction/constraint semantics. Never in production.
# DATABASE_URL=sqlite://

# ── Termux listener (set these ON THE PHONE instead — see termux/install.sh) ─
# The listener reads ~/.mfs_gateway/config.json or these env vars:
# GATEWAY_SERVER_URL=https://your-gateway-domain.com
# GATEWAY_DEVICE_ID=dev_xxxxxxxx
# GATEWAY_DEVICE_SECRET=dsec_xxxxxxxxxxxxxxxxxxxxxxxx
